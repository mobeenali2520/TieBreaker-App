{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profile metadata and access status records.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "role": { "type": "string", "enum": ["admin", "user"] }
      },
      "required": ["uid", "email", "displayName", "status", "role"]
    },
    "projects": {
      "title": "Projects",
      "description": "Decision analysis matrix projects per user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title"]
    }
  }
}
